# Copiar a .env (gitignored) y completar antes de `docker compose up`.

# API key de TabPFN-v2 (ux.priorlabs.ai/account) para el servicio `inference`.
# Sin ella, la carga del modelo falla al iniciar si la licencia no fue
# aceptada de forma interactiva (ver README > TabPFN-v2 en Windows).
TABPFN_TOKEN=
